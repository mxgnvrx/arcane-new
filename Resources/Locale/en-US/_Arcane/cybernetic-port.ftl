anti-drop-tightened = Your grip tightens.

anti-drop-relaxed = Your hands relax.

anti-drop-empty = You are not holding anything. Your hands relax.

laser-arm-extend = {CAPITALIZE(THE($user))} extends {THE($gun)} from {POSS-ADJ($user)} arm.

laser-arm-extend-self = You extend {THE($gun)} from your arm.

laser-arm-retract = {CAPITALIZE(THE($user))} retracts {THE($gun)} back into {POSS-ADJ($user)} arm.

laser-arm-retract-self = {CAPITALIZE(THE($gun))} snaps back into your arm.

laser-arm-drop = You drop {THE($item)} to activate {THE($implant)}.

laser-arm-hand-blocked = {CAPITALIZE(THE($item))} prevents you from using {THE($implant)}!

laser-arm-broken = {CAPITALIZE(THE($implant))} doesn't respond. It seems to be broken...

laser-arm-emp = A loud bang comes from {THE($user)}'s arm!

laser-arm-emp-self = You feel an explosion erupt inside your arm as your implant breaks!

ent-UpgradedHerculeanSpineAugment = upgraded Herculean spinal implant
    .desc = An upgraded spinal implant that gives a greater boost to athletics, throws, unarmed blows and grabs. A gravity anomaly core can upgrade it to Atlas.
ent-AtlasSpineAugment = Atlas gravitronic spinal implant
    .desc = A gravity-core upgrade for the Herculean implant that lets the wearer walk on surfaces in zero gravity and greatly improves their athletics, throws, unarmed blows and grabs.

bluespace-grounding-teleport-blocked = You feel yourself teleporting, but are suddenly flung back to where you just were!

cns-rebooter-activated = Your CNS rebooter restores control of your body!

cns-rebooter-ready = Your CNS rebooter is ready.
